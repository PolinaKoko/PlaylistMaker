<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="MainMenuScreenTitleStyle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">?attr/colorOnPrimary</item>
        <item name="android:textSize">@dimen/text_size_title</item>
        <item name="fontFamily">@font/ys_display_medium</item>
        <item name="android:textFontWeight">500</item>
    </style>

    <style name="MainMenuButtonStyle" parent="Widget.MaterialComponents.Button.UnelevatedButton">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">0dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:padding">0dp</item>
        <item name="android:gravity">center</item>
        <item name="android:backgroundTint">@color/white</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:insetLeft">0dp</item>
        <item name="android:insetRight">0dp</item>
        <item name="cornerRadius">@dimen/button_corner_radius</item>
        <item name="iconGravity">textStart</item>
        <item name="iconPadding">@dimen/icon_padding</item>
        <item name="iconTint">@color/black</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">@dimen/text_size_button</item>
        <item name="android:fontFamily">@font/ys_display_medium</item>
        <item name="android:textFontWeight">500</item>
        <item name="android:textColor">@color/black</item>
        <item name="android:letterSpacing">0.0</item>
        <item name="android:lineSpacingMultiplier">1.0</item>
    </style>

    <style name="SettingsTitleStyle">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:textSize">@dimen/text_size_settings_title</item>
        <item name="fontFamily">@font/ys_display_medium</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>

    <style name="SettingsItemTextStyle">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:textSize">@dimen/text_size_settings_item</item>
        <item name="fontFamily">@font/ys_display_regular</item>
        <item name="android:textFontWeight">500</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>

    <style name="SettingsItemContainerStyle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:paddingHorizontal">@dimen/padding_horizontal_item</item>
        <item name="android:paddingVertical">@dimen/padding_vertical_item</item>
        <item name="android:background">?attr/selectableItemBackground</item>
    </style>

    <style name="SettingsSwitchStyle" parent="ThemeOverlay.AppCompat">
        <item name="colorControlActivated">@color/blue</item>
        <item name="colorSwitchThumbNormal">@color/gray</item>
        <item name="colorControlHighlight">@color/blue_light</item>
        <item name="colorControlNormal">@color/light_gray</item>
        <item name="android:colorForeground">@color/light_gray</item>
    </style>

    <style name="SettingsIconStyle">
        <item name="android:layout_width">@dimen/icon_size_medium</item>
        <item name="android:layout_height">@dimen/icon_size_medium</item>
        <item name="tint">?attr/colorOnSurfaceVariant</item>
    </style>

    <style name="SearchTitleStyle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">@dimen/text_size_settings_title</item>
        <item name="android:fontFamily">@font/ys_display_medium</item>
        <item name="android:textFontWeight">500</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>

    <style name="SearchEditTextStyle" parent="Widget.AppCompat.EditText">
        <item name="android:textColor">@color/black</item>
        <item name="android:textColorHint">?attr/colorOnSurfaceVariant</item>
        <item name="android:drawableTint">?attr/colorOnSurfaceVariant</item>
        <item name="android:textCursorDrawable">@drawable/cursor_blue</item>
    </style>

    <style name="Theme.PlaylistMaker.TrackItem">
        <item name="colorOnSurfaceVariant">@color/gray</item>
        <item name="colorOnSurface">@color/black</item>
    </style>

    <style name="TrackTitleStyle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">@dimen/track_title_text_size</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:fontFamily">@font/ys_display_regular</item>
        <item name="maxLines">1</item>
        <item name="android:ellipsize">end</item>
    </style>

    <style name="TrackSubtitleStyle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">@dimen/track_subtitle_text_size</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
        <item name="fontFamily">@font/ys_display_regular</item>
        <item name="maxLines">1</item>
        <item name="android:ellipsize">end</item>
    </style>

    <style name="PlaceholderIconStyle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginBottom">@dimen/placeholder_icon_margin_bottom</item>
    </style>


    <style name="PlaceholderContainerStyle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">0dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:orientation">vertical</item>
        <item name="android:gravity">center_horizontal</item>
        <item name="android:layout_marginTop">@dimen/placeholder_container_margin_top</item>
    </style>

    <style name="PlaceholderTitleStyle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">@dimen/placeholder_title_text_size</item>
        <item name="android:layout_marginStart">@dimen/placeholder_text_margin_horizontal</item>
        <item name="android:layout_marginEnd">@dimen/placeholder_text_margin_horizontal</item>
        <item name="android:fontFamily">@font/ys_display_medium</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:gravity">center</item>
    </style>

    <style name="PlaceholderButtonStyle" parent="Widget.MaterialComponents.Button.UnelevatedButton">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">@dimen/placeholder_button_text_size</item>
        <item name="android:fontFamily">@font/ys_display_medium</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:lineSpacingMultiplier">1</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingStart">@dimen/placeholder_button_padding_horizontal</item>
        <item name="android:paddingEnd">@dimen/placeholder_button_padding_horizontal</item>
        <item name="android:paddingTop">@dimen/placeholder_button_padding_vertical</item>
        <item name="android:paddingBottom">@dimen/placeholder_button_padding_vertical</item>
        <item name="android:layout_marginTop">@dimen/placeholder_button_margin_top</item>
        <item name="cornerRadius">@dimen/placeholder_button_corner_radius</item>
        <item name="backgroundTint">@color/black</item>
    </style>


</resources>
