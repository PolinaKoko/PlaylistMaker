<resources>

    <style name="Theme.PlaylistMaker" parent="Theme.MaterialComponents.DayNight.NoActionBar">

        <item name="colorPrimary">@color/blue</item>
        <item name="colorOnPrimary">@color/white</item>


        <item name="colorSurface">@color/white</item>
        <item name="colorOnSurface">@color/black</item>

        <item name="colorSurfaceVariant">@color/light_gray</item>
        <item name="colorOnSurfaceVariant">@color/gray</item>

        <item name="android:statusBarColor">@color/white</item>
        <item name="android:windowLightStatusBar">true</item>

        <item name="searchFieldBackground">@color/light_gray</item>
        <item name="searchIconColor">@color/gray</item>
        <item name="searchHintColor">@color/gray</item>

        <item name="tabTextColorInactive">@color/black</item>
        <item name="tabTextColorActive">@color/black</item>
        <item name="tabIndicatorColor">@color/black</item>

        <item name="bottomNavigationStyle">@style/BottomNavigationStyle</item>

        <item name="elevationOverlayEnabled">false</item>
    </style>


</resources>